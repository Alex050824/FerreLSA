# Configurá este valor cuando el backend tenga su endpoint real de inicio de sesión.
# Ejemplo ilustrativo de URL: http://localhost:3000/api/auth/login
VITE_LOGIN_ENDPOINT=

# Ruta del panel interno de React después de que el backend valide las credenciales.
# Ejemplo: /dashboard (solo si esa ruta ya existe en tu aplicación)
VITE_AFTER_LOGIN_PATH=
