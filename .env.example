# Base MySQL (DATABASE_URL puede usarse en lugar de las variables DB_*).
DB_NAME=ferrelsa_db
DB_USER=root
DB_PASSWORD=1234
DB_HOST=127.0.0.1
DB_PORT=3306

# Clave privada de al menos 32 caracteres para las sesiones del ERP.
ERP_JWT_SECRET=

# URL HTTPS de inserción de Power BI. Usá solo datos ficticios en "Publicar en la web".
POWER_BI_REPORT_URL=
